{
	"name": "codex-loadbalancer",
	"displayName": "CODEX LoadBalancer",
	"description": "Bun-based Codex/OpenAI-compatible proxy that rotates local ChatGPT account tokens",
	"publisher": "JUNGHO",
	"license": "Apache-2.0",
	"version": "1.0.0",
	"main": "src/index.ts",
	"bin": {
		"codex-loadbalancer": "src/index.ts"
	},
	"files": [
		"src",
		"readme.md",
		"readme.ko.md",
		"architecture.md",
		"architecture.ko.md",
		"license.md"
	],
	"keywords": [
		"codex",
		"openai",
		"chatgpt",
		"load-balancer",
		"proxy",
		"bun"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JUNGHO-GIT/CODEX-LOADBALANCER.git"
	},
	"scripts": {
		"git": "bun ~/.bootstrap/bootstrap-sync.mjs --git",
		"sync": "bun ~/.bootstrap/bootstrap-sync.mjs --sync",
		"tools": "bun ~/.bootstrap/bootstrap-sync.mjs --tools",
		"start": "bun src/index.ts",
		"dev": "bun --watch src/index.ts",
		"check": "bunx tsc --noEmit -p tsconfig.json",
		"test": "bun test",
		"lint": "bunx biome check ."
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"dependencies": {
		"@clack/prompts": "^1.2.0",
		"dotenv": "^17.4.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.13",
		"@types/node": "25.6.0",
		"typescript": "6.0.3"
	}
}
