{
  "name": "codex-loadbalancer",
  "displayName": "CODEX LoadBalancer",
  "description": "A load balancer for CODEX applications",
  "publisher": "JUNGHO",
  "license": "Apache-2.0",
  "version": "1.0.0",
  "main": "index.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/JUNGHO-GIT/CODEX-LOADBALANCER.git"
  },
  "scripts": {
    "git": "bun ~/.bootstrap/bootstrap-sync.mjs --git",
    "sync": "bun ~/.bootstrap/bootstrap-sync.mjs --sync",
    "tools": "bun ~/.bootstrap/bootstrap-sync.mjs --tools",
		"start": "bun src/index.ts",
		"dev": "bun --watch src/index.ts",
		"check": "bunx tsc --noEmit -p tsconfig.json",
		"test": "bun test",
		"lint": "bunx biome check ."
	},
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/node": "25.6.0",
    "typescript": "6.0.3"
  }
}
