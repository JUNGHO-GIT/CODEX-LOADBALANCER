{
  "compilerOptions": {
    "rootDir": "./",
    "rootDirs": [],
    "outDir": "./out",
    "paths": {
      "@assets/*": ["./src/assets/*"],
      "@type/*": ["./src/assets/type/domain/*"],
      "@middlewares/*": ["./src/middlewares/*"],
      "@repositories/*": ["./src/repositories/*"],
      "@routers/*": ["./src/routers/*"],
      "@schemas/*": ["./src/schemas/*"],
      "@services/*": ["./src/services/*"]
    },
    "typeRoots": ["./src/assets/type/dist", "node_modules/@types"],
    "types": ["node"],
    "lib": ["DOM", "DOM.Iterable", "ESNext"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    "**/*.js",
    "**/*.jsx",
    "./src/**/*",
    "./src/**/*.ts",
    "./src/**/*.tsx"
  ],
  "exclude": [
    "bin",
    "build",
    "client",
    "dist",
    "node_modules",
    "out",
    "**/*.spec.ts"
  ]
}
